{
	"manifest_version": 3,
	"name": "EarthMC Dynmap+",
	"version": "26.3.2",
	"author": "3meraldK",
	"description": "Enrich the EarthMC map exploration's experience",

	"icons": {
		"48": "icon.png"
	},

	"content_scripts": [
		{
			"js": ["version-helper.js"],
			"matches": ["https://earthmc.net/map*", "https://legacymap.earthmc.net/*", "https://aurora.earthmc.net/*"],
			"run_at": "document_start"
		},
		{
			"js": ["main.js"],
			"css": ["style.css"],
			"matches": ["https://earthmc.net/map*", "https://legacymap.earthmc.net/*", "https://aurora.earthmc.net/*"],
			"world": "MAIN",
			"run_at": "document_start"
		}
	],

    "host_permissions": [
		"https://web.archive.org/*",
		"https://legacymap.earthmc.net/*",
		"https://earthmc.net/map*"
	],
	"permissions": ["declarativeNetRequest"],
	"background": {
		"service_worker": "cors-bypass.js"
	}
}